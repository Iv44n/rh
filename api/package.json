{
  "name": "rh-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "compile": "bun build --compile --minify --sourcemap ./src/index.ts --outfile arcton-app",
    "dev": "bun --hot src/index.ts",
    "test": "bun test",
    "format": "biome format --write",
    "check": "biome check",
    "lint": "biome check --fix",
    "auth:gen": "bunx --bun auth@latest generate --config src/modules/auth/config.ts --output src/modules/auth/auth.schemas.ts",
    "db:generate": "bunx --bun drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bunx --bun drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "bunx --bun drizzle-kit push --config drizzle.config.ts",
    "db:studio": "bunx --bun drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@arcton/core": "^0.0.12",
    "@arcton/cors": "^0.0.7",
    "@arcton/logger": "^0.0.3",
    "@arcton/openapi": "^0.0.1",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "resend": "^6.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^1.0.0-rc.4"
  }
}
